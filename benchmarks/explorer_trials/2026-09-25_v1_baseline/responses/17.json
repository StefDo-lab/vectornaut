{
  "governing_equation": "d2u_dy2 = 0",
  "boundary_conditions": [
    "u(0) = compliance_slip_coefficient * viscous_length_scale / equivalent_laminar_gap * du_dy(0)",
    "u(1) = freestream_velocity"
  ],
  "independent_variables": ["y"],
  "dependent_variables": ["u"],
  "parameters": [
    {"name": "compliant_layer_thickness", "value": 0.003, "min_bound": 0.001, "max_bound": 0.01, "justification": "Gel layer"},
    {"name": "shear_modulus", "value": 25000.0, "min_bound": 5000.0, "max_bound": 200000.0, "justification": "c_t about 0.5 U"},
    {"name": "loss_factor", "value": 0.3, "min_bound": 0.05, "max_bound": 0.8, "justification": "Damping"},
    {"name": "layer_density", "value": 1000.0, "min_bound": 900.0, "max_bound": 1200.0, "justification": "Gel"},
    {"name": "freestream_velocity", "value": 10.0, "min_bound": 3.0, "max_bound": 15.0, "justification": "Cruise speed"},
    {"name": "water_dynamic_viscosity", "value": 0.0012, "min_bound": 0.0009, "max_bound": 0.0018, "justification": "Seawater"},
    {"name": "viscous_length_scale", "value": 3.8e-06, "min_bound": 1e-06, "max_bound": 1e-05, "justification": "nu/u_tau at 10 m/s"},
    {"name": "equivalent_laminar_gap", "value": 1.2e-4, "min_bound": 3e-5, "max_bound": 5e-4, "justification": "H = nu*U/u_tau^2 reproducing the 100 Pa smooth-wall shear"},
    {"name": "compliance_slip_coefficient", "value": 0.45, "min_bound": 0.0, "max_bound": 2.0, "justification": "EMPIRICAL closure: effective slip length in viscous units that reproduces the 0-7 % drag reductions reported for tuned compliant coatings (Choi et al. 1997); not derived from the layer properties"}
  ]
}
