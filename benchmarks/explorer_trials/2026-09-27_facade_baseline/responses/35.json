{
 "governing_equation": "d2T_dx2 = 0",
 "boundary_conditions": [
  "dT_dx(0) = -(outer_heat_transfer_coefficient*(T_air - T(0)) + render_solar_absorptance*solar_irradiance - render_emittance*net_longwave_sky_loss)*(1/wall_conductance + cork_thickness/cork_conductivity)",
  "T(1) = T_indoor"
 ],
 "independent_variables": [
  "x"
 ],
 "dependent_variables": [
  "T"
 ],
 "parameters": [
  {
   "name": "wall_conductance",
   "value": 0.526,
   "min_bound": 0.2,
   "max_bound": 5.0,
   "justification": "Conductance of wall/roof layers plus inner film, 1/(1/U - 1/h_o) for U=0.5 W/m2K and h_o=20 W/m2K; x normalised over the wall thickness."
  },
  {
   "name": "T_air",
   "value": 311.15,
   "min_bound": 300.0,
   "max_bound": 320.0,
   "justification": "Daytime mean summer air temperature 38 C."
  },
  {
   "name": "T_indoor",
   "value": 298.15,
   "min_bound": 293.0,
   "max_bound": 303.0,
   "justification": "Conditioned indoor air 25 C."
  },
  {
   "name": "solar_irradiance",
   "value": 300.0,
   "min_bound": 150.0,
   "max_bound": 600.0,
   "justification": "West wall."
  },
  {
   "name": "render_emittance",
   "value": 0.9,
   "min_bound": 0.8,
   "max_bound": 0.95,
   "justification": "Mineral render."
  },
  {
   "name": "net_longwave_sky_loss",
   "value": 20.0,
   "min_bound": 0.0,
   "max_bound": 60.0,
   "justification": "Vertical wall."
  },
  {
   "name": "cork_thickness",
   "value": 0.06,
   "min_bound": 0.0,
   "max_bound": 0.15,
   "justification": "Cork board thickness; 0 = no cladding (baseline)."
  }
 ]
