{
 "governing_equation": "d2T_dx2 = 0",
 "boundary_conditions": [
  "dT_dx(0) = -(outer_heat_transfer_coefficient*(T_air - T(0)) + solar_absorptance*solar_irradiance - thermal_emittance*net_longwave_sky_loss)/wall_conductance",
  "dT_dx(1) = -(pcm_clamp_coefficient*(T(1) - pcm_melting_temperature) + inner_film_coefficient*(T(1) - T_indoor))/wall_conductance"
 ],
 "independent_variables": [
  "x"
 ],
 "dependent_variables": [
  "T"
 ],
 "parameters": [
  {
   "name": "wall_conductance",
   "value": 0.548,
   "min_bound": 0.2,
   "max_bound": 5.0,
   "justification": "Conductance of the wall layers without surface films: 1/(1/0.5 - 1/20 - 1/8)."
  },
  {
   "name": "T_air",
   "value": 311.15,
   "min_bound": 300.0,
   "max_bound": 320.0,
   "justification": "Daytime mean air 38 C."
  },
  {
   "name": "T_indoor",
   "value": 298.15,
   "min_bound": 293.0,
   "max_bound": 303.0,
   "justification": "Room air 25 C."
  },
  {
   "name": "inner_film_coefficient",
   "value": 8.0,
   "min_bound": 5.0,
   "max_bound": 10.0,
   "justification": "Inner surface combined coefficient."
  },
  {
   "name": "pcm_clamp_coefficient",
   "value": 1000.0,
   "min_bound": 0.0,
   "max_bound": 5000.0,
   "justification": "Large coupling that holds the inner surface at the melting temperature while the PCM melts (0 = no PCM)."
  },
  {
   "name": "outer_heat_transfer_coefficient",
   "value": 20.0,
   "min_bound": 8.0,
   "max_bound": 35.0,
   "justification": "Exposed wall."
  },
  {
   "name": "solar_absorptance",
   "value": 0.32,
   "min_bound": 0.1,
   "max_bound": 0.6,
   "justification": "Outer face keeps the conventional aged cool paint."
  },
  {
   "name": "solar_irradiance",
   "value": 300.0,
   "min_bound": 150.0,
   "max_bound": 600.0,
   "justification": "West wall."
  },
  {
   "name": "thermal_emittance",
   "value": 0.9,
   "min_bound": 0.8,
   "max_bound": 0.95,
   "justification": "Paint."
  },
  {
   "name": "net_longwave_sky_loss",
   "value": 20.0,
   "min_bound": 0.0,
   "max_bound": 60.0,
   "justification": "Vertical wall."
  }
 ]
}