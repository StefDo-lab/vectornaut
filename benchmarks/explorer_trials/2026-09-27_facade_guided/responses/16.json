{
  "governing_equation": "d2T_dx2 = 0",
  "boundary_conditions": [
    "T(0) = indoor_temperature",
    "dT_dx(1) / (1 / wall_u_value + cork_thickness / cork_conductivity) = (1 - skin_solar_reflectance_aged) * solar_irradiance_daily_mean + external_heat_transfer_coefficient * (ambient_temperature - T(1)) - skin_thermal_emittance * net_sky_longwave"
  ],
  "independent_variables": ["x"],
  "dependent_variables": ["T"],
  "parameters": [
    {"name": "indoor_temperature", "value": 298.15, "min_bound": 293.15, "max_bound": 301.15, "justification": "Conditioned interior at 25 C."},
    {"name": "ambient_temperature", "value": 308.15, "min_bound": 298.15, "max_bound": 318.15, "justification": "Daily-mean outdoor air."},
    {"name": "external_heat_transfer_coefficient", "value": 15.0, "min_bound": 8.0, "max_bound": 30.0, "justification": "Combined outer film coefficient."},
    {"name": "skin_thermal_emittance", "value": 0.9, "min_bound": 0.85, "max_bound": 0.95, "justification": "Mineral silicate render."},
    {"name": "cork_thickness", "value": 0.04, "min_bound": 0.0, "max_bound": 0.1, "justification": "Lower bound 0 = no cork (baseline)."}
  ]
}
