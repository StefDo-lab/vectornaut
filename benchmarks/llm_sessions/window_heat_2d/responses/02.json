{
  "governing_equation": "d2T_dx2 + ((2*glass_thickness + gap_width)/window_height)**2 * d2T_dy2 = 0",
  "boundary_conditions": [
    "dT_dx(0, y) = h_outside*(2*glass_thickness/glass_conductivity + gap_width/gas_conductivity)*(T(0, y) - outdoor_temperature)",
    "dT_dx(1, y) = h_inside*(2*glass_thickness/glass_conductivity + gap_width/gas_conductivity)*(indoor_temperature - T(1, y))",
    "dT_dy(x, 0) = 0",
    "dT_dy(x, 1) = 0"
  ],
  "independent_variables": ["x", "y"],
  "dependent_variables": ["T"]
}
