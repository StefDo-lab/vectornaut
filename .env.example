GEMINI_API_KEY=
VECTORNAUT_DATA_DIR=.
VECTORNAUT_MAX_EPOCHS=1000
VECTORNAUT_MAX_OPTIMIZATION_ROUNDS=10
VECTORNAUT_SCRIPT_TIMEOUT_SECONDS=60
# Optional: Gemini model per pipeline stage. Resolution order:
# VECTORNAUT_MODEL_<STAGE> -> VECTORNAUT_MODEL -> gemini-3.5-flash
# Stages: MINER, FORMULATOR, AUDITOR, OPTIMIZER, SYNTHESIZER, SCRIPT_GENERATOR, TEST_GENERATOR, CHAT,
# EXPLORER, CRITIC, ANALYST (idea-space explorer; a stronger critic/analyst helps, e.g. gemini-3.1-pro-preview)
VECTORNAUT_MODEL=
# VECTORNAUT_MODEL_AUDITOR=
# VECTORNAUT_MODEL_CRITIC=gemini-3.1-pro-preview
# VECTORNAUT_MODEL_ANALYST=gemini-3.1-pro-preview
# Optional: thinking level per stage (minimal, low, medium, high); invalid values are ignored.
# Defaults: MINER=medium, FORMULATOR=medium, AUDITOR=high, EXPLORER=medium, CRITIC=medium, ANALYST=high;
# all other stages send no thinking config.
# VECTORNAUT_THINKING_AUDITOR=high
